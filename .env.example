NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opțional: cheia publică legacy anon, dacă nu se folosește Publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opțional: valoarea "off" dezactivează modul de depanare local (cod fix 123456 la
# verificarea emailului și a telefonului). Implicit modul este activ la
# `npm run dev` și mereu inactiv în producție.
NEXT_PUBLIC_DEMO_AUTH=
